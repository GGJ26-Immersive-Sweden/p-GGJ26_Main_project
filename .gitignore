/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size and contain sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity3D generated meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ════════════════════════════════════════════════════════════
# UNITY 6 / VR SPECIFIC
# ════════════════════════════════════════════════════════════

# Burst compiler cache
/[Ll]ibrary/[Bb]urst[Cc]ache/

# Shader cache (platform-specific, regenerated)
/[Ll]ibrary/[Ss]hader[Cc]ache/

# IL2CPP build artifacts
/[Ll]ibrary/Il2cppBuildCache/

# XR settings overrides
/[Xx]R[Ss]ettings/

